{
  "name": "chang-wei-lin-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc --noEmit -p tsconfig.json && vite build --config vite.config.ts",
    "build:github-pages": "tsc --noEmit -p tsconfig.github-pages.json && vite build --config vite.config.ts --mode github-pages",
    "preview": "vite preview --config vite.config.ts",
    "sync:readme-images": "node scripts/sync-readme-images.js",
    "sync:resume-endpoint": "node scripts/resume-sync-endpoint.js",
    "track:github-updates": "node scripts/github-last-updated.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2"
  }
}
